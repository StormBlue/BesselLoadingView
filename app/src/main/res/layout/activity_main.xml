<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/eyebrow" android:textColor="@color/secondary" android:textSize="12sp" android:letterSpacing="0.12" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/title" android:textColor="@color/foreground" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/subtitle" android:textColor="@color/secondary" android:textSize="16sp" />
        <com.bluestrom.gao.customview.BesselLoadingView
            android:id="@+id/ring" android:layout_width="180dp" android:layout_height="180dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:layout_marginBottom="16dp"
            android:padding="8dp" android:contentDescription="@string/loading_description"
            app:bessel_strokeWidth="8dp" app:bessel_autoStart="true" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textColor="@color/foreground" android:textSize="20sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="@string/controls" android:textColor="@color/secondary" android:textSize="12sp" android:letterSpacing="0.12" />
        <Switch android:id="@+id/shape" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/shape" android:textColor="@color/foreground" />
        <Switch android:id="@+id/warm" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/warm" android:textColor="@color/foreground" />
        <Switch android:id="@+id/slow" android:layout_width="match_parent" android:layout_height="48dp"
            android:text="@string/slow" android:textColor="@color/foreground" />
        <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/start" />
        <Button android:id="@+id/stop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/stop" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:text="@string/footer" android:textColor="@color/secondary" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
